{
  "name": "notaria-motor-agentico",
  "version": "1.0.0",
  "description": "Plataforma Agéntica para Automatización de Trámites Notariales, Verificación de Linderos con Doble IA y Gestión de Constructoras (Gemini 3.8 Flash + PostgreSQL 18 + NoSQL Dinámico)",
  "private": true,
  "scripts": {
    "dev:backend": "ts-node-dev --respawn --transpile-only backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "start": "node backend/dist/server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
