# Configuración Local y Google Cloud Platform (Lista para conectar mañana)
PORT=4000

# Modelos de IA en Vertex AI (Visión Multimodal Pura · Cero OCR tradicional)
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_CONTRAST=gemini-3.1-pro
GCP_PROJECT_ID=pendiente-asignar-manana
GCP_REGION=us-central1

# Base de Datos Cloud SQL for PostgreSQL 18 (RLS + uuidv7 + JSONB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notaria_db_pg18
